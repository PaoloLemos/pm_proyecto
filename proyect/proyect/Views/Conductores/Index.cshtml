@model IEnumerable<proyect.Models.Conductores>

@{
    ViewBag.Title = "Conductores";
}

<h2 class="text-center text-white mb-4">🎙️ Conductores</h2>

<div class="text-center mb-4">
    @Html.ActionLink("➕ Agregar nuevo conductor", "Create", null, new { @class = "btn btn-success px-4 py-2 fw-bold" })
</div>


<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.foto))
                {
                    <img src="@item.foto" class="card-img-top" alt="@item.Nombre" style="height: 200px; object-fit: cover;" />
                }
                else
                {
                    <img src="~/Content/imagenes/Conductores/default.jpg" class="card-img-top" alt="Sin foto" style="height: 200px; object-fit: cover;">
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Nombre</h5>
                    <p class="card-text flex-grow-1">@item.Bio</p>

                    @if (item.Programas != null)
                    {
                        <p class="text-muted"><i>Programa:</i>@item.Programas.Nombre</p>
                    }

                    <div class="mt-auto">
                        @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                        @Html.ActionLink("Detalles", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary me-1" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                    </div>
                </div>
            </div>
        </div>
    }
</div>



<style>
    h2.text-white {
        font-size: 2.5rem;
        font-weight: 600;
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.6);
    }

    .card {
        border-radius: 1rem;
        overflow: hidden;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

    .card-title {
        font-weight: bold;
        font-size: 1.3rem;
    }

    .card-text {
        font-size: 0.95rem;
    }

    .card-img-top {
        border-bottom: 1px solid #ddd;
    }

    .btn-outline-primary,
    .btn-outline-secondary,
    .btn-outline-danger {
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .text-muted i {
        font-style: italic;
    }

    body {
        background: linear-gradient(180deg, #0d1b2a, #1b263b);
        color: #fff;
    }

    .btn-success {
        border-radius: 20px;
    }

    .text-end a.btn {
        font-weight: 500;
    }
</style>

