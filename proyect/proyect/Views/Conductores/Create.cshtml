@model proyect.Models.Conductores

@{
    ViewBag.Title = "Crear Conductor";
}

<h2>Crear Conductor</h2>

@using (Html.BeginForm("Create", "Conductores", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Bio)
        @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4 })
    </div>

    <div class="form-group">
        @Html.Label("Foto (URL o subir)")
        <input type="file" name="FotoFile" class="form-control" />
    </div>

    

    <button type="submit" class="btn btn-success">Crear</button>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
