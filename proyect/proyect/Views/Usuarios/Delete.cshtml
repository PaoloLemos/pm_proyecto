@model proyect.Models.Usuarios
@using proyect.Security

@{
    ViewBag.Title = "Eliminar Usuario";
    var customUser = User as CustomPrincipal;
}

<style>
    .btn-editar {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.9em;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
        text-align: center;
        user-select: none;
        background-color: #e0f3ff;
        color: #007bff;
        border: 1px solid #007bff;
        cursor: pointer;
    }

        .btn-editar:hover {
            background-color: #007bff;
            color: white;
        }

    .btn-eliminar {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.9em;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
        text-align: center;
        user-select: none;
        background-color: #ffe0e0;
        color: #dc3545;
        border: 1px solid #dc3545;
        cursor: pointer;
    }

        .btn-eliminar:hover {
            background-color: #dc3545;
            color: white;
        }

    /* Contenedor centrado y cuadro blanco */
    .container-delete {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .box-delete {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        max-width: 600px;
        width: 100%;
    }

    dl {
        margin-bottom: 30px;
    }

    dt {
        font-weight: 600;
        color: #444;
    }

    dd {
        margin-bottom: 15px;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        gap: 15px;
    }

    .btn {
        flex-grow: 1;
    }
</style>

<div class="container-delete">
    <div class="box-delete">
        <h3 class="text-center mb-4">Confirmar eliminación de usuario</h3>

        <dl class="row">
            <dt class="col-5 text-end">Nombre:</dt>
            <dd class="col-7">@Html.DisplayFor(m => m.Nombre)</dd>

            <dt class="col-5 text-end">Email:</dt>
            <dd class="col-7">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-5 text-end">Rol:</dt>
            <dd class="col-7">@Html.DisplayFor(m => m.Roles.Nombre)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions">
                <input type="submit" value="Eliminar" class="btn-eliminar" />
                @Html.ActionLink("Volver", "Index", null, new { @class = "btn-editar" })
            </div>
        }
    </div>
</div>