@model proyect.Models.Usuarios
@using proyect.Security

@{
    ViewBag.Title = "Crear Usuario";
}

<style>
    .form-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .form-box {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
        max-width: 600px;
        width: 100%;
    }

        .form-box h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: bold;
            color: #333;
        }

    .form-horizontal .form-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 15px;
    }

    .form-horizontal label.control-label {
        flex: 0 0 30%;
        max-width: 30%;
        font-weight: 600;
    }

    .form-horizontal .col-md-10 {
        flex: 0 0 70%;
        max-width: 70%;
    }

    .form-control {
        width: 100%;
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 1em;
    }

    .btn-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-custom {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 1em;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid;
        transition: all 0.2s ease;
    }

    .btn-create {
        color: #007bff;
        border-color: #007bff;
        background-color: #e0f3ff;
    }

        .btn-create:hover {
            background-color: #007bff;
            color: white;
        }

    .btn-back {
        color: #dc3545;
        border-color: #dc3545;
        background-color: #ffe0e0;
    }

        .btn-back:hover {
            background-color: #dc3545;
            color: white;
        }
</style>

<div class="form-container">
    <div class="form-box">
        <h2>Crear Usuario</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Contrasena, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Contrasena, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Contrasena, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.RolID, htmlAttributes: new { @class = "control-label" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(
                            model => model.RolID,
                            new SelectList(ViewBag.Roles, "RolID", "Nombre", Model?.RolID),
                            "-- Seleccione un rol --",
                            new { @class = "form-control" }
                        )
                        @Html.ValidationMessageFor(model => model.RolID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="btn-row">
                    <input type="submit" value="Crear" class="btn-custom btn-create" />
                    @Html.ActionLink("Volver", "Index", null, new { @class = "btn-custom btn-back" })
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}