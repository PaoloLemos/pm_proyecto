@model proyect.Models.Noticias

@{
    ViewBag.Title = Model.Titulo;
}

<div class="detalle-noticia">
    <h1>@Model.Titulo</h1>

    <p class="fecha">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</p>

    @if (!string.IsNullOrWhiteSpace(Model.Imagen))
    {
        <img src="@Model.Imagen" alt="Imagen de @Model.Titulo" class="imagen-noticia" />
    }

    <div class="contenido-noticia">
        <p>@Model.Contenido</p>
    </div>

    <p>
        <a href="@Url.Action("Index")" class="btn btn-secondary">← Volver a noticias</a>
    </p>
</div>


<style>
    .detalle-noticia {
        max-width: 800px;
        margin: auto;
        padding: 20px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

        .detalle-noticia h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

    .fecha {
        color: #777;
        font-size: 0.9em;
        margin-bottom: 15px;
    }

    .imagen-noticia {
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .contenido-noticia {
        font-size: 1.1em;
        line-height: 1.6em;
    }

</style>