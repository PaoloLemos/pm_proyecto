@model IEnumerable<proyect.Models.Programas>
@{
    ViewBag.Title = "Home Page";
}

<!-- Hero Section -->
<section id="hero" class="position-relative overflow-hidden mb-5" style="height: 60vh;">
    <video autoplay muted loop playsinline class="w-100 h-100 object-fit-cover">
        <source src="~/videos/hero.mp4" type="video/mp4">
        Tu navegador no soporta vídeo.
    </video>
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white px-3">
        <h1 class="display-5 display-md-3 fw-bold">Bienvenido a Voz del Este</h1>
        <p class="lead fst-italic">La emisora que suena al ritmo de la costa</p>
        <a href="#player" class="btn btn-lg btn-outline-light mt-4 px-4">🎧 Escucha en vivo</a>
    </div>
</section>

<!-- Player en vivo -->
<section id="player" class="container mb-5">
    <div class="bg-dark bg-opacity-75 text-white p-4 rounded shadow d-flex flex-column flex-md-row align-items-center gap-3">
        <span class="badge bg-danger fs-6 px-3 py-2">🔴 EN VIVO</span>
        <audio controls class="w-100">
            <source src="https://stream.vozdeleste.fm/live.mp3" type="audio/mpeg">
            Tu navegador no soporta audio en vivo.
        </audio>
    </div>
</section>

<!-- Programación destacada -->
<section class="container mb-5">

    <section class="container mb-5">
        <h2 class="mb-4 text-center fw-semibold" style="color: white">📻 Programación destacada</h2>
        <div class="row g-4">
            @foreach (var programa in Model)
            {<div class="col-12 col-md-4">
    <div class="card h-100 shadow-sm">
        <div class="ratio ratio-16x9">
            <img src="@programa.Imagen" class="card-img-top object-fit-cover" alt="@programa.Nombre" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@programa.Nombre</h5>

            <a href="@Url.Action("Details", "Programas", new { id = programa.Id })" class="btn btn-outline-primary mt-auto">Ver más</a>
        </div>
    </div>
</div>
            }
        </div>
    </section>

</section>

<!-- Newsletter -->
<section class="container my-5">
    <div class="p-5 bg-dark bg-opacity-75 text-white rounded text-center shadow">
        <h3 class="mb-3">📬 Suscríbete a nuestro boletín</h3>
        <p class="mb-4">Recibe los mejores hits y noticias directo en tu inbox.</p>
        <form class="row justify-content-center g-3">
            <div class="col-12 col-md-6 col-lg-4">
                <input type="email" class="form-control" placeholder="Tu correo electrónico" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-light">Suscribirme</button>
            </div>
        </form>
    </div>


    @{ Html.RenderAction("Logos", "Patrocinadores"); }


</section>