@model List<proyect.Models.ProgramacionHoraria>

@{
    var diasSemana = new[] { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo" };
    var horas = Enumerable.Range(0, 24).Select(h => TimeSpan.FromHours(h)).ToList(); // 00:00 a 23:00
    ViewBag.OcultarFooter = true;

}

<h2 class="text-center my-4" style="color:white">📻 Programación semanal</h2>

<div class="table-responsive">
    <table class="table table-bordered text-center align-middle table-striped">
        <thead class="table-dark">
            <tr>
                <th>Hora</th>
                @foreach (var dia in diasSemana)
                {
                    <th>@dia</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var hora in horas)
            {
                <tr>
                    <td>@hora.ToString(@"hh\:mm")</td>
                    @foreach (var dia in diasSemana)
                    {
                        var enEsteHorario = Model
                            .Where(p => p.DiaSemana == dia &&
                                        p.HoraInicio <= hora &&
                                        hora < p.HoraFin)
                            .FirstOrDefault();

                        if (enEsteHorario != null)
                        {
                            var conductor = enEsteHorario.Programas.Conductores.FirstOrDefault();
                            <td class="bg-primary text-white">
                                <strong>@enEsteHorario.Programas.Nombre</strong><br />
                                @if (conductor != null)
                                {
                                    <small>con @conductor.Nombre</small>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="text-muted">—</td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">Volver a la página principal</a>
</div>
<style>

    .grilla-semanal td {
        min-width: 130px;
        vertical-align: middle;
    }

    .table td, .table th {
        padding: 0.75rem;
    }


</style>