@model proyect.Models.Programas

@{
    ViewBag.Title = "Eliminar Programa";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="p-4 rounded-4 shadow" style="background-color: white; max-width: 600px; width: 100%;">
        <h2 class="text-center mb-3" style="border-bottom: 2px solid #333; padding-bottom: 8px;">Eliminar Programa</h2>

        <h5 class="text-center text-danger mb-4">¿Estás seguro de que deseas eliminar este programa?</h5>

        <dl class="row mb-4">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Imagen)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Imagen)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Descripcion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-center gap-3">
                <input type="submit" value="Eliminar" class="btn btn-sm btn-danger px-4" />
                @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-sm btn-outline-primary px-4" })
            </div>
        }
    </div>
</div>