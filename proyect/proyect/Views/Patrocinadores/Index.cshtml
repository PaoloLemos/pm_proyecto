@model IEnumerable<proyect.Models.Patrocinadores>

@{
    ViewBag.Title = "Patrocinadores";
}

<h2 class="text-center text-white mb-4">🤝 Patrocinadores</h2>

<div class="text-center mb-4">
    @Html.ActionLink("➕ Agregar nuevo patrocinador", "Create", null, new { @class = "btn btn-success px-4 py-2 fw-bold" })
</div>

@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.Imagen))
                    {
                        <img src="@Url.Content(item.Imagen)" class="card-img-top"
                             style="height: 200px; object-fit: contain; background-color: #f8f9fa;" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/Content/imagenes/Patrocinadores/default.jpg")" class="card-img-top"
                             style="height: 200px; object-fit: contain; background-color: #f8f9fa;" />
                    }


                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Nombre</h5>
                        <p class="card-text flex-grow-1">@item.Descripcion</p>
                        <p class="text-muted">📦 Plan: @item.Plan</p>

                        <div class="mt-auto">
                            @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary me-1" })
                            @Html.ActionLink("Detalles", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary me-1" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center">
        No hay patrocinadores registrados aún.
    </div>
}


<style>
    h2.text-white {
        font-size: 2.5rem;
        font-weight: 600;
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.6);
    }

    .card {
        border-radius: 1rem;
        overflow: hidden;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s;
        background-color: #ffffff;
        color: #212529;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
        }

    .card-title {
        font-weight: bold;
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
    }

    .card-text {
        font-size: 0.95rem;
    }

    .card-img-top {
        border-bottom: 1px solid #ddd;
        background-color: #f8f9fa;
    }

    .btn-outline-primary,
    .btn-outline-secondary,
    .btn-outline-danger {
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .btn-success {
        border-radius: 20px;
        font-weight: 600;
    }

    body {
        background: linear-gradient(180deg, #0d1b2a, #1b263b);
        color: #fff;
    }

    .text-muted {
        font-size: 0.85rem;
        color: #6c757d !important;
    }

    .text-center .btn {
        font-weight: 500;
    }

    .row-cols-md-3 > .col {
        display: flex;
    }

    .card.h-100 {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .card-body {
        display: flex;
        flex-direction: column;
    }
</style>
