@model IEnumerable<proyect.Models.Patrocinadores>

<div class="bg-white py-3">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4">
            @foreach (var patrocinador in Model)
            {
                if (!string.IsNullOrEmpty(patrocinador.Imagen))
                {
                    <img src="@Url.Content(patrocinador.Imagen)" alt="Logo @patrocinador.Nombre"
                         style="max-height: 60px; object-fit: contain;" />
                }
            }
        </div>
    </div>
</div>
